<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:Launcher.App.Behaviors"
                    xmlns:controls="clr-namespace:Launcher.App.Controls"
                    xmlns:res="clr-namespace:Launcher.App.Resources"
                    xmlns:settings="clr-namespace:Launcher.App.ViewModels.Settings">
    <Style x:Key="SettingsOptionTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.F2F2F2}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="SettingsDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource LauncherTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <DataTemplate x:Key="JavaSelectionOptionTemplate">
        <TextBlock Text="{Binding Title}"
                   Foreground="{DynamicResource Brush.F4F4F4}"
                   FontSize="13"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="DownloadSourceOptionTemplate"
                  DataType="{x:Type settings:SettingsDownloadSourceOption}">
        <TextBlock Text="{Binding Title}"
                   Foreground="{DynamicResource Brush.F4F4F4}"
                   FontSize="13"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="UpdateChannelOptionTemplate"
                  DataType="{x:Type settings:SettingsUpdateChannelOption}">
        <TextBlock Text="{Binding Title}"
                   Foreground="{DynamicResource Brush.F4F4F4}"
                   FontSize="13"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="ThemeOptionTemplate"
                  DataType="{x:Type settings:SettingsThemeOption}">
        <TextBlock Text="{Binding Title}"
                   Foreground="{DynamicResource Brush.F4F4F4}"
                   FontSize="13"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="BackgroundEffectOptionTemplate"
                  DataType="{x:Type settings:SettingsBackgroundEffectOption}">
        <TextBlock Text="{Binding Title}"
                   Foreground="{DynamicResource Brush.F4F4F4}"
                   FontSize="13"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="LanguageOptionTemplate"
                  DataType="{x:Type settings:SettingsLanguageOption}">
        <TextBlock Text="{Binding Title}"
                   Foreground="{DynamicResource Brush.F4F4F4}"
                   FontSize="13"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <!-- A fixed multicolour illustration for the custom-colour option. -->
    <DrawingBrush x:Key="CustomAccentColorWheelBrush" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M50,50 L50,0 100,0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush MappingMode="Absolute" StartPoint="50,0" EndPoint="100,0">
                            <GradientStop Color="#F44336" Offset="0" />
                            <GradientStop Color="#FF9800" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M50,50 L100,0 100,50 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush MappingMode="Absolute" StartPoint="100,0" EndPoint="100,50">
                            <GradientStop Color="#FF9800" Offset="0" />
                            <GradientStop Color="#FFEB3B" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M50,50 L100,50 100,100 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush MappingMode="Absolute" StartPoint="100,50" EndPoint="100,100">
                            <GradientStop Color="#FFEB3B" Offset="0" />
                            <GradientStop Color="#4CAF50" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M50,50 L100,100 50,100 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush MappingMode="Absolute" StartPoint="100,100" EndPoint="50,100">
                            <GradientStop Color="#4CAF50" Offset="0" />
                            <GradientStop Color="#00BCD4" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M50,50 L50,100 0,100 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush MappingMode="Absolute" StartPoint="50,100" EndPoint="0,100">
                            <GradientStop Color="#00BCD4" Offset="0" />
                            <GradientStop Color="#2196F3" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M50,50 L0,100 0,50 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush MappingMode="Absolute" StartPoint="0,100" EndPoint="0,50">
                            <GradientStop Color="#2196F3" Offset="0" />
                            <GradientStop Color="#673AB7" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M50,50 L0,50 0,0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush MappingMode="Absolute" StartPoint="0,50" EndPoint="0,0">
                            <GradientStop Color="#673AB7" Offset="0" />
                            <GradientStop Color="#E91E63" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M50,50 L0,0 50,0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="50,0">
                            <GradientStop Color="#E91E63" Offset="0" />
                            <GradientStop Color="#F44336" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="AccentColorPreviewEllipseStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Blue}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Id}" Value="Custom">
                <Setter Property="Fill" Value="{StaticResource CustomAccentColorWheelBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Cyan">
                <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Cyan}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Green">
                <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Green}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Emerald">
                <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Emerald}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Purple">
                <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Purple}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Pink">
                <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Pink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Orange">
                <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Orange}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Id}" Value="Amber">
                <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Amber}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="AccentColorOptionTemplate"
                  DataType="{x:Type settings:SettingsAccentColorOption}">
        <StackPanel Orientation="Horizontal">
            <Ellipse Style="{StaticResource AccentColorPreviewEllipseStyle}" />
            <TextBlock Text="{Binding Title}"
                       Foreground="{DynamicResource Brush.F4F4F4}"
                       FontSize="13"
                       VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="SettingsChoiceListBoxStyle" TargetType="ListBox">
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="behaviors:SmoothScrollBehavior.IsEnabled" Value="True" />
        <Setter Property="behaviors:SmoothScrollBehavior.AllowContentScroll" Value="True" />
        <Setter Property="behaviors:SmoothScrollBehavior.ScrollAmount" Value="92" />
        <Setter Property="behaviors:SmoothScrollBehavior.WheelAnimationDurationMilliseconds" Value="130" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JavaRuntimeListBoxStyle"
           TargetType="ListBox"
           BasedOn="{StaticResource SettingsChoiceListBoxStyle}" />

    <Style x:Key="SettingsChoiceListBoxItemStyle"
           TargetType="ListBoxItem"
           BasedOn="{StaticResource DialogChoiceItemStyle}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="JavaRuntimeListBoxItemStyle"
           TargetType="ListBoxItem"
           BasedOn="{StaticResource SettingsChoiceListBoxItemStyle}">
        <Setter Property="IsHitTestVisible"
                Value="{Binding DataContext.IsJavaManualSelection, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
    </Style>

    <DataTemplate x:Key="JavaRuntimeItemTemplate">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DisplayName}"
                           Foreground="{DynamicResource Brush.F4F4F4}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding VersionText}"
                           Margin="10,0,0,0"
                           Foreground="{DynamicResource LauncherTextSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBlock Text="{Binding Architecture}"
                           Foreground="{DynamicResource Brush.CFFFFFFF}"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="2"
                       Margin="0,4,0,0"
                       Text="{Binding ExecutablePath}"
                       Foreground="{DynamicResource Brush.AFFFFFFF}"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MinecraftDirectoryItemTemplate"
                  DataType="{x:Type settings:SettingsMinecraftDirectoryItem}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding DisplayName}"
                           ToolTip="{Binding DisplayName}"
                           behaviors:TextOverflowToolTip.IsEnabled="True"
                           Foreground="{DynamicResource Brush.F4F4F4}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <TextBlock Margin="0,4,0,0"
                           Text="{Binding DirectoryPath}"
                           ToolTip="{Binding DirectoryPath}"
                           behaviors:TextOverflowToolTip.IsEnabled="True"
                           Foreground="{DynamicResource Brush.AFFFFFFF}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Margin="0,4,0,0"
                           Text="{Binding AvailabilityText}"
                           Foreground="{DynamicResource LauncherDangerBrush}"
                           FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Margin="12,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="IsHitTestVisible" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                         Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Button Style="{StaticResource InlineIconButtonStyle}"
                        ToolTip="{x:Static res:Strings.Settings_RenameMinecraftDirectoryButton}"
                        Command="{Binding DataContext.RequestRenameMinecraftDirectoryCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                        CommandParameter="{Binding}">
                    <controls:SvgIcon Width="16"
                                      Height="16"
                                      IconKey="general/general_edit"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Button>

                <Button Margin="4,0,0,0"
                        Style="{StaticResource InlineIconButtonStyle}"
                        IsEnabled="{Binding IsAvailable}"
                        ToolTip="{x:Static res:Strings.Settings_OpenMinecraftDirectoryButton}"
                        Command="{Binding DataContext.OpenMinecraftDirectoryCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                        CommandParameter="{Binding}">
                    <controls:SvgIcon Width="16"
                                      Height="16"
                                      IconKey="general/general_folder"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Button>

                <Button Margin="4,0,0,0"
                        Style="{StaticResource SecondaryMenuDeleteButtonStyle}"
                        ToolTip="{x:Static res:Strings.Settings_RemoveMinecraftDirectoryFromListButton}"
                        ToolTipService.ShowOnDisabled="True"
                        Command="{Binding DataContext.RequestRemoveMinecraftDirectoryCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                        CommandParameter="{Binding}">
                    <controls:SvgIcon Width="16"
                                      Height="16"
                                      IconKey="setting_page/remove_folder"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Button>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="InteractiveControlItemTemplate"
                  DataType="{x:Type settings:SettingsInteractiveControlItem}">
        <StackPanel>
            <TextBlock Text="{Binding Title}"
                       Foreground="{DynamicResource Brush.F4F4F4}"
                       FontSize="13"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="0,3,0,0"
                       Text="{Binding Category}"
                       Foreground="{DynamicResource LauncherTextSecondaryBrush}"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
