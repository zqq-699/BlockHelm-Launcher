<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Launcher.Application\Launcher.Application.csproj" />
    <ProjectReference Include="..\Launcher.Domain\Launcher.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.86.1" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.86.1" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <PackageReference Include="XboxAuthNet.Game.Msal" Version="0.1.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildProjectDirectory)\..\.local-secrets\curseforge.key"
                      Condition="Exists('$(MSBuildProjectDirectory)\..\.local-secrets\curseforge.key')"
                      LogicalName="Launcher.Infrastructure.CurseForge.curseforge.key" />
    <EmbeddedResource Include="$(MSBuildProjectDirectory)\..\.local-secrets\mcres-bhl.key"
                      Condition="Exists('$(MSBuildProjectDirectory)\..\.local-secrets\mcres-bhl.key')"
                      LogicalName="Launcher.Infrastructure.Resources.mcres-bhl.key" />
    <EmbeddedResource Include="$(MSBuildProjectDirectory)\..\.local-secrets\microsoft-client-id"
                      Condition="Exists('$(MSBuildProjectDirectory)\..\.local-secrets\microsoft-client-id')"
                      LogicalName="Launcher.Infrastructure.Accounts.microsoft-client-id" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Modpacks\Log4Shell\*.xml"
                      LogicalName="Launcher.Infrastructure.Modpacks.Log4Shell.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\ResourceLocalization\Data\mods.v1.jsonl"
                      LogicalName="Launcher.Infrastructure.Resources.ResourceLocalization.mods.v1.jsonl" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <Target Name="WarnMissingCurseForgeEmbeddedKey" BeforeTargets="CoreCompile"
          Condition="!Exists('$(MSBuildProjectDirectory)\..\.local-secrets\curseforge.key')">
    <Warning Text="CurseForge API key file was not found at $(MSBuildProjectDirectory)\..\.local-secrets\curseforge.key. The launcher will be built without an embedded CurseForge key." />
  </Target>

  <Target Name="WarnMissingMcresBhlEmbeddedKey" BeforeTargets="CoreCompile"
          Condition="!Exists('$(MSBuildProjectDirectory)\..\.local-secrets\mcres-bhl.key')">
    <Warning Text="MCRES BHL API key file was not found at $(MSBuildProjectDirectory)\..\.local-secrets\mcres-bhl.key. The launcher will be built without an embedded MCRES BHL key." />
  </Target>

  <Target Name="WarnMissingMicrosoftClientId" BeforeTargets="CoreCompile"
          Condition="!Exists('$(MSBuildProjectDirectory)\..\.local-secrets\microsoft-client-id')">
    <Warning Text="Microsoft application client ID was not found at $(MSBuildProjectDirectory)\..\.local-secrets\microsoft-client-id. Microsoft account login will be unavailable." />
  </Target>

</Project>
